<UserControl x:Class="luhpads.View.UserControls.Header"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:luhpads.View.UserControls"
             mc:Ignorable="d"
             d:DesignHeight="70" d:DesignWidth="800">
    <Grid>
        <Button Background="Transparent" Width="70" HorizontalAlignment="Left" Margin="6,0,0,0" Click="Button_Click"></Button>
        <Menu Background="Transparent" Panel.ZIndex="-1" BorderThickness="0">
            <Menu.Effect>
                <DropShadowEffect/>
            </Menu.Effect>
            
            <Image Source="/img/logo.jpg"></Image>
            <MenuItem Header="Inicio" FontSize="22" FontWeight="Light" Foreground="Black" VerticalAlignment="Center" Click="MenuItem_Click" Margin="5, 5, 5, 5" FontFamily="Courier New"></MenuItem>
            <MenuItem Header="Galeria" FontSize="22" FontWeight="Light" Foreground="Black" VerticalAlignment="Center" Click="MenuItem_Click_1" Margin="5, 5, 5, 5" FontFamily="Courier New"></MenuItem>
            
        </Menu>
        <Image Source="/img/usuario.png" HorizontalAlignment="Right" OpacityMask="White"></Image>
        <Button Width="50" Height="50" HorizontalAlignment="Right" Panel.ZIndex="1" Margin="10" BorderThickness="0" Background="Transparent" Click="Button_Click_1"></Button>
    </Grid>
</UserControl>
