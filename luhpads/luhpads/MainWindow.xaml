<Window x:Class="luhpads.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:gif="http://wpfanimatedgif.codeplex.com"
        xmlns:local="clr-namespace:luhpads"
        xmlns:UserControls="clr-namespace:luhpads.View.UserControls"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.Resources>
        <Style x:Key="ImageHoverStyle" TargetType="{x:Type Image}">
            <Style.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Width"
                                         To="350"
                                         Duration="0:0:0.7">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetProperty="Height"
                                         To="350"
                                         Duration="0:0:0.7">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>

                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Width"
                                         To="250"
                                         Duration="0:0:0.7"/>
                            <DoubleAnimation Storyboard.TargetProperty="Height"
                                         To="250"
                                         Duration="0:0:0.7"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>



    <Grid Background="#5AB8B8B8">

        <Grid.RowDefinitions>
            <RowDefinition Height="70"></RowDefinition>
            <RowDefinition Height="40*"></RowDefinition>
            <RowDefinition Height="60*"></RowDefinition>
        </Grid.RowDefinitions>
        <!-- Header -->
        <UserControls:Header></UserControls:Header>
        <!-- Gif + Novedad -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="1">
                <Rectangle Stretch="Fill" Fill="#0BFFFFFF">
                    <Rectangle.Effect>
                        <DropShadowEffect/>
                    </Rectangle.Effect>
                </Rectangle>
                <TextBlock Margin="15, 0, 0, 0" FontSize="50" Text="WallHack" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="Courier New"></TextBlock>
                <TextBlock Margin="15, 0, 0, 0" FontSize="70" Text="x" VerticalAlignment="Center" HorizontalAlignment="Center" FontFamily="Courier New"></TextBlock>
                <TextBlock Margin="15, 0" FontSize="50" Text="Berserk" VerticalAlignment="Bottom" HorizontalAlignment="Right" FontFamily="Courier New"></TextBlock>
            </Grid>
            <Grid Grid.Column="0">
                <Image gif:ImageBehavior.AnimatedSource="/img/gif.gif" Panel.ZIndex="1" Margin="23,3,10,0" Stretch="Fill" OpacityMask="White">
                    <Image.Effect>
                        <DropShadowEffect/>
                    </Image.Effect>
                </Image>
            </Grid>

        </Grid>
        <!-- Show de Pads -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="80*"></RowDefinition>
                <RowDefinition Height="20*"></RowDefinition>
            </Grid.RowDefinitions>
            <!-- Animaciones -->



            <!-- Imagenes de alfrombrillas -->
            <Image x:Name="Berserk" Source="/img/sp h 005BE no bg.png" Panel.ZIndex="2"  Grid.Column="1" Width="300" Height="300" Style="{StaticResource ImageHoverStyle}"></Image>
            <Image x:Name="Negra" Source="/img/sp h 005B no bg.png" Panel.ZIndex="2" Grid.Column="0" Width="300" Height="300" Style="{StaticResource ImageHoverStyle}"></Image>
            <Image x:Name="Gris" Source="/img/sp h 005W no bg.png"  Panel.ZIndex="2" Grid.Column="2" Width="300" Height="300" Style="{StaticResource ImageHoverStyle}"></Image>
            <!-- Textos de alfrombrillas -->
            <TextBlock x:Name="NegraT" Text="SP 005B" Grid.Row="1" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Courier New" FontSize="48" MouseEnter="NegraT_MouseEnter" MouseLeave="NegraT_MouseLeave"></TextBlock>
            <TextBlock x:Name="BerserkT" Text="SP 005BE" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Courier New" FontSize="48" MouseEnter="BerserkT_MouseEnter" MouseLeave="BerserkT_MouseLeave"></TextBlock>
            <TextBlock x:Name="GrisT" Text="SP 005W" Grid.Row="1" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Courier New" FontSize="48" MouseEnter="GrisT_MouseEnter" MouseLeave="GrisT_MouseLeave"></TextBlock>
        </Grid>

    </Grid>
</Window>
